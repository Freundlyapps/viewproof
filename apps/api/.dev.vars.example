# Copy to .dev.vars (git-ignored) and fill in. Never commit real values.
# Google OAuth client (Web application) — redirect URI: http://localhost:8787/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 32 random bytes, base64. Generate with: openssl rand -base64 32
TOKEN_KEY=
# Optional: YouTube search interest (Google Trends via DataForSEO). Off unless DATAFORSEO_DISPLAY_OK=yes.
# DATAFORSEO_LOGIN=
# DATAFORSEO_PASSWORD=
# DATAFORSEO_DISPLAY_OK=
# Optional: YouTube Data API key — competitor @handles and subscriber counts.
# YOUTUBE_API_KEY=
# Optional included AI (README "AI"). Leave empty for none; users can still add their own key.
AI_API_KEY=
# AI_PROVIDER=anthropic
# AI_QUICK_MODEL=
# AI_COACH_MODEL=
# Optional billing (README "Billing"). All three set = Upgrade/Cancel in Settings → Plan & usage. Use test-mode keys locally.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_ID=
# Shown on /privacy, /terms and /imprint (legal notice). Google's OAuth verification needs a reachable contact;
# a commercial service run from Germany also needs a postal address (§ 5 DDG). Address lines are split by \n.
# OPERATOR_NAME=
# CONTACT_EMAIL=
# OPERATOR_ADDRESS=Street 1\n12345 City\nCountry
